diff --git a/packages/client/ui-subagent/src/client/catalog-groups.ts b/packages/client/ui-subagent/src/client/catalog-groups.ts
new file mode 100644
index 0000000000..69d6e83c5b
--- /dev/null
+++ b/packages/client/ui-subagent/src/client/catalog-groups.ts
@@ -0,0 +1,69 @@
+/** 从已加载目录派生分类树；保留跨分类条目的真实父会话，不发起读取。 */
+import type { SessionProjectionMap, SessionProjectionSnapshot } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** 带展示状态与跨分类导航地址的目录项。 */
+export type CatalogEntry = SessionProjectionMap['subagentCatalog'][number] & {
+  activity: 'running' | 'inactive'
+  parentSessionId?: SessionId
+}
+
+/** 原生投影的加载状态与当前分类可见条目。 */
+export type SubagentCatalogSnapshot = Omit<SessionProjectionSnapshot, 'values' | 'state'> & {
+  state: 'idle' | 'loading' | 'ready' | 'migration-required' | 'error'
+  entries: CatalogEntry[]
+}
+
+/** 共享投影中已加载的各会话目录。 */
+export type Catalogs = Readonly<Record<SessionId, SubagentCatalogSnapshot>>
+
+/** 一类条目的目录树与入口计数成员。 */
+export interface CatalogGroup {
+  category: string
+  catalogs: Catalogs
+  entries: CatalogEntry[]
+}
+
+/**
+ * 按 category 派生工作树和其他分类的可达子树，缺省分类为 work。
+ * 跨分类条目提升到该分类入口，保留真实父地址；同类后代仍由原生展开控制。
+ * @param catalogs - 已加载的完整目录，不读取未加载层级。
+ * @param rootSessionId - 当前入口的目录根。
+ * @returns 工作分组在前，其余分组按首次发现顺序排列。
+ */
+export function groupCatalogs(catalogs: Catalogs, rootSessionId: SessionId): CatalogGroup[] {
+  const categories = new Map<string, CatalogEntry[]>([['work', []]])
+  const roots = new Map<string, CatalogEntry[]>()
+  const visited = new Set<SessionId>()
+  const visit = (parentSessionId: SessionId, parentCategory?: string): void => {
+    if (visited.has(parentSessionId)) return
+    visited.add(parentSessionId)
+    for (const entry of catalogs[parentSessionId]?.entries ?? []) {
+      const category = entry.category ?? 'work'
+      const entries = categories.get(category) ?? []
+      if (!categories.has(category)) categories.set(category, entries)
+      entries.push(entry)
+      if (category !== 'work' && (parentSessionId === rootSessionId || parentCategory !== category)) {
+        const promoted = roots.get(category) ?? []
+        if (!roots.has(category)) roots.set(category, promoted)
+        promoted.push({ ...entry, parentSessionId })
+      }
+      if (entry.mode !== 'external') visit(entry.id, category)
+    }
+  }
+  visit(rootSessionId)
+  return [...categories].map(([category, entries]) => {
+    const filtered: Record<SessionId, SubagentCatalogSnapshot> = Object.fromEntries(
+      Object.entries(catalogs).map(([id, catalog]) => [id, {
+        ...catalog, entries: catalog.entries.filter(entry => (entry.category ?? 'work') === category),
+      }]),
+    )
+    if (category !== 'work' && catalogs[rootSessionId] !== undefined) {
+      filtered[rootSessionId] = { ...catalogs[rootSessionId], entries: roots.get(category) ?? [] }
+    }
+    return {
+      category, catalogs: filtered,
+      entries: category === 'work' ? filtered[rootSessionId]?.entries ?? [] : entries,
+    }
+  })
+}
