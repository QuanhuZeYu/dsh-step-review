--- /dev/null
+++ b/packages/subagent/subagent/src/capacity-pools.ts
@@ -0,0 +1,41 @@
+/** 可信调用方的独立容量池与当前进程内的本地子级绑定。 */
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { ActivationPool } from './activation.ts'
+import { SubagentError } from './error.ts'
+import type { SubagentCapacityPool } from './types.ts'
+
+export class CapacityPools {
+  private readonly pools = new WeakMap<SubagentCapacityPool, { slots: ActivationPool; capacity: () => number }>()
+  private readonly bindings = new WeakMap<Agent, Map<SessionId, SubagentCapacityPool>>()
+
+  create(capacity: () => number): SubagentCapacityPool {
+    const handle = Object.freeze({}) as SubagentCapacityPool
+    this.pools.set(handle, { slots: new ActivationPool(), capacity })
+    return handle
+  }
+
+  resolve(root: Agent, childId: SessionId | undefined, requested: SubagentCapacityPool | undefined): SubagentCapacityPool | undefined {
+    const pool = requested ?? (childId === undefined ? undefined : this.bindings.get(root)?.get(childId))
+    if (pool !== undefined && !this.pools.has(pool)) {
+      throw new SubagentError('capacity pool does not belong to this subagent runtime', 'INVALID_CAPACITY_POOL')
+    }
+    return pool
+  }
+
+  reserve(handle: SubagentCapacityPool): () => void {
+    const entry = this.pools.get(handle)
+    if (entry === undefined) throw new SubagentError('capacity pool does not belong to this subagent runtime', 'INVALID_CAPACITY_POOL')
+    const capacity = entry.capacity()
+    if (!Number.isSafeInteger(capacity) || capacity < 1) {
+      throw new SubagentError('independent activation capacity must be a positive safe integer', 'INVALID_CAPACITY_POOL_LIMIT')
+    }
+    return entry.slots.reserve(capacity, 'independent capacity pool')
+  }
+
+  remember(root: Agent, childId: SessionId, pool: SubagentCapacityPool): void {
+    let children = this.bindings.get(root)
+    if (children === undefined) { children = new Map(); this.bindings.set(root, children) }
+    children.set(childId, pool)
+  }
+}
