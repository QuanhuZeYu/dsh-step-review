{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src/client/**/*.tsx",
    "src/client/**/*.d.ts"
  ]
}